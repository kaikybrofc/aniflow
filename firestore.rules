rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidUserBookmark(data) {
      return data.id is string &&
             data.id.size() > 0 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 &&
             data.savedAt is timestamp &&
             data.savedAt <= request.time;
    }

    function isValidUserTrackedAnime(data) {
      return data.id is string &&
             data.id.size() > 0 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.animeTitle is string &&
             data.animeTitle.size() > 0 &&
             data.dayOfWeek is int &&
             data.dayOfWeek >= 1 &&
             data.dayOfWeek <= 7 &&
             data.trackedAt is timestamp &&
             data.trackedAt <= request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidUserBookmark(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /tracked/{trackedId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidUserTrackedAnime(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
